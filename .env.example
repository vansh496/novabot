# ============================================================
#  Bot ki settings - is file ko .env naam se save karein
#  (Notepad mein kholein, "Save As" -> file name: .env)
# ============================================================

# --- Bot (Developer Portal -> Bot -> Token) ---
DISCORD_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Aapka Discord User ID (owner alerts ke liye)
BOT_OWNER_ID=PASTE_YOUR_USER_ID_HERE

# --- Dashboard (Developer Portal -> OAuth2) ---
CLIENT_ID=PASTE_YOUR_CLIENT_ID_HERE
CLIENT_SECRET=PASTE_YOUR_CLIENT_SECRET_HERE
REDIRECT_URI=http://localhost:5000/callback

# Koi bhi lambi random string bana lein
SECRET_KEY=change_this_to_a_long_random_string

# Dashboard ka address (bot ke /help mein dikhega)
DASHBOARD_URL=http://localhost:5000
